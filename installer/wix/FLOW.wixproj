<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>FLOW-v1.0.0-win-x64</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\artifacts\publish\win-x64</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
    <OutputPath>..\..\artifacts\installer\</OutputPath>
  </PropertyGroup>
</Project>
