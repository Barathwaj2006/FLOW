<Window x:Class="Flow.Host.Windows.UI.FlowHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FLOW — Voice Productivity Hub"
        Height="700" Width="1020"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Modern Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Tab Style -->
        <Style x:Key="NavTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="6" Margin="0,3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Subtitle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FLOW" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    <TextBlock Text="|" FontSize="18" Foreground="#475569" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Voice Productivity Hub" FontSize="16" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status Badge (Center) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="14" Padding="14,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusBadgeText" Text="FLOW Active &amp; Ready" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Quick Action Buttons (Right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenScratchpad" Content="Scratchpad" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnOpenScratchpad_Click"/>
                    <Button x:Name="BtnOpenHistory" Content="History" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnOpenHistory_Click"/>
                    <Button x:Name="BtnMinimizeTray" Content="Minimize to Tray" Style="{StaticResource PrimaryButtonStyle}" Click="BtnMinimizeTray_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Navigation & Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar Nav -->
                <ColumnDefinition Width="220"/>
                <!-- Tab Pages -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="14,16">
                <StackPanel>
                    <TextBlock Text="NAVIGATION" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="8,0,0,10"/>
                    <ListBox x:Name="NavListBox" Background="Transparent" BorderThickness="0" SelectedIndex="0" SelectionChanged="NavListBox_SelectionChanged">
                        <ListBoxItem Content="  Dashboard" IsSelected="True" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Padding="10,8" Margin="0,2"/>
                        <ListBoxItem Content="  Audio &amp; Microphone" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Padding="10,8" Margin="0,2"/>
                        <ListBoxItem Content="  Languages &amp; Model" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Padding="10,8" Margin="0,2"/>
                        <ListBoxItem Content="  Personalization" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Padding="10,8" Margin="0,2"/>
                        <ListBoxItem Content="  Developer Mode" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Padding="10,8" Margin="0,2"/>
                        <ListBoxItem Content="  Command Mode" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Padding="10,8" Margin="0,2"/>
                        <ListBoxItem Content="  Diagnostics &amp; About" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Padding="10,8" Margin="0,2"/>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Main Content Area with Pages -->
            <TabControl x:Name="MainTabControl" Grid.Column="1" Background="Transparent" BorderThickness="0" SelectedIndex="0" Margin="24,18">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- PAGE 0: DASHBOARD -->
                <TabItem Header="Dashboard">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Hero Banner Card -->
                            <Border Style="{StaticResource CardBorderStyle}" Background="#1E293B">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="System-Wide Voice Dictation" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Hold Right-Alt to speak into any application. Release to insert formatted text." Foreground="#94A3B8" Margin="0,4,0,12"/>
                                        <WrapPanel>
                                            <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                                <TextBlock Text="Push-to-Talk: Hold [Right Alt]" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                            <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                                <TextBlock Text="Hands-Free: Double-Tap [Right Alt]" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                            <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                                <TextBlock Text="Backtrack: [Shift + Right Alt]" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                            <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                                <TextBlock Text="Command Mode: [Ctrl + Right Alt]" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Button x:Name="BtnToggleDictation" Grid.Column="1" Content="Toggle Dictation" Style="{StaticResource PrimaryButtonStyle}"
                                            VerticalAlignment="Center" Padding="18,12" Click="BtnToggleDictation_Click"/>
                                </Grid>
                            </Border>

                            <!-- Live Microphone Activity Card -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Live Microphone Activity" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtActiveDevice" Text="Active Device: Detecting WASAPI endpoint..." Foreground="#CBD5E1" FontSize="13"/>
                                        <TextBlock x:Name="TxtAudioLevelPercent" Grid.Column="1" Text="Level: 0%" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"/>
                                    </Grid>
                                    <ProgressBar x:Name="ProgressBarAudioLevel" Height="10" Minimum="0" Maximum="100" Value="0"
                                                 Foreground="#10B981" Background="#334155" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- In-App Dictation Test Box -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Live Dictation Test Area" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                    <TextBlock Text="Click below and hold Right-Alt to test speech-to-text directly in this window:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,10"/>
                                    <TextBox x:Name="TxtTestDictation" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                             Padding="10" FontSize="14" FontFamily="Segoe UI"
                                             Text="Welcome to FLOW. Click here, hold Right-Alt, speak a sentence, and release."/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="Clear Test Box" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClearTest_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PAGE 1: AUDIO & MICROPHONE -->
                <TabItem Header="Audio">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Windows Audio Capture (WASAPI)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                                    <TextBlock Text="Select the physical microphone used for on-device voice processing." Foreground="#94A3B8" Margin="0,0,0,14"/>

                                    <TextBlock Text="Capture Endpoint:" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ComboAudioDevices" Height="34" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,14"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnRefreshDevices" Content="Refresh Devices" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="BtnRefreshDevices_Click"/>
                                        <Button x:Name="BtnApplyDevice" Content="Apply Selected Device" Style="{StaticResource PrimaryButtonStyle}" Click="BtnApplyDevice_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Voice Activity Detection (VAD) Sensitivity" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                                    <TextBlock Text="Controls how aggressively FLOW distinguishes silence from human speech." Foreground="#94A3B8" Margin="0,0,0,12"/>
                                    <Slider x:Name="SliderVadThreshold" Minimum="0.005" Maximum="0.05" Value="0.015" TickFrequency="0.005" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>
                                    <TextBlock Text="Current Energy Threshold: 0.015 (Standard Desktop)" Foreground="#38BDF8" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PAGE 2: LANGUAGES & MODEL -->
                <TabItem Header="Languages">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Local Whisper ASR Engine" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                                    <TextBlock Text="Transcription executes 100% on-device using local Whisper GGML model weights." Foreground="#94A3B8" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Active Model:" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtModelName" Grid.Column="1" Text="ggml-tiny.en.bin (Verified Official)" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Model File Path:" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TxtModelPath" Grid.Column="1" Text="%LOCALAPPDATA%\FLOW\models\ggml-tiny.en.bin" Foreground="#CBD5E1"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hardware Mode:" Foreground="#94A3B8"/>
                                        <TextBlock Text="Native Whisper.net C++ with AVX2 &amp; DirectML acceleration" Foreground="#CBD5E1"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Engine State:" Foreground="#94A3B8"/>
                                        <TextBlock Text="Ready for Instant Inference" Foreground="#10B981" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Dictation Language" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                                    <TextBlock Text="Select target speech language or enable automatic detection." Foreground="#94A3B8" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="ComboLanguages" Height="34" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" SelectedIndex="0" Margin="0,0,0,14">
                                        <ComboBoxItem Content="English (en) — Optimized Tiny.en Low-Latency"/>
                                        <ComboBoxItem Content="Auto-Detect (auto) — Multilingual Tiny"/>
                                        <ComboBoxItem Content="Tamil (ta) — Multilingual"/>
                                        <ComboBoxItem Content="Spanish (es) — Multilingual"/>
                                        <ComboBoxItem Content="French (fr) — Multilingual"/>
                                        <ComboBoxItem Content="German (de) — Multilingual"/>
                                        <ComboBoxItem Content="Hindi (hi) — Multilingual"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PAGE 3: PERSONALIZATION -->
                <TabItem Header="Personalization">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Personal Dictionary &amp; Custom Corrections" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                                    <TextBlock Text="Ensure domain-specific terms, names, and technical vocabulary are transcribed accurately." Foreground="#94A3B8" Margin="0,0,0,12"/>
                                    <TextBlock Text="Stored in local SQLite database with zero cloud sync." Foreground="#38BDF8" FontSize="12" Margin="0,0,0,14"/>
                                    <WrapPanel>
                                        <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                            <TextBlock Text="Personal Dictionary: Active" Foreground="#CBD5E1"/>
                                        </Border>
                                        <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                            <TextBlock Text="Voice Snippets Expansion: Active" Foreground="#CBD5E1"/>
                                        </Border>
                                        <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                            <TextBlock Text="Style Formatting: Active" Foreground="#CBD5E1"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PAGE 4: DEVELOPER MODE -->
                <TabItem Header="Developer">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Developer &amp; Programming Mode" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                                    <TextBlock Text="Automatically formats spoken code identifiers and protects technical syntax." Foreground="#94A3B8" Margin="0,0,0,14"/>

                                    <CheckBox x:Name="ChkDevMode" Content="Enable Developer Mode" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14" Checked="ChkDevMode_Changed" Unchecked="ChkDevMode_Changed"/>

                                    <TextBlock Text="Spoken Identifier Casing Style:" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ComboDevCasing" Height="34" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" SelectedIndex="0" Margin="0,0,0,14">
                                        <ComboBoxItem Content="camelCase (e.g. getUserProfile)"/>
                                        <ComboBoxItem Content="PascalCase (e.g. GetUserProfile)"/>
                                        <ComboBoxItem Content="snake_case (e.g. get_user_profile)"/>
                                        <ComboBoxItem Content="SCREAMING_SNAKE_CASE (e.g. MAX_BUFFER_SIZE)"/>
                                        <ComboBoxItem Content="kebab-case (e.g. user-profile-card)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PAGE 5: COMMAND MODE -->
                <TabItem Header="Command">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Dedicated Voice Command Mode (WF-036)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                                    <TextBlock Text="Dedicated shortcut: [Ctrl + Right Alt]" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock Text="Command Mode is strictly isolated from normal dictation. Under normal dictation, FLOW will NEVER execute commands, submit forms, or press Enter." Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <TextBlock Text="Command Safety Policy: Active &amp; Gated" Foreground="#10B981" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="• Zero arbitrary process execution (Zero Process.Start / ShellExecute)" Foreground="#94A3B8"/>
                                    <TextBlock Text="• Allowlist-only app activation via modern Windows URI protocols" Foreground="#94A3B8"/>
                                    <TextBlock Text="• Safe text transforms (Uppercase, Lowercase, Title Case)" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PAGE 6: DIAGNOSTICS & ABOUT -->
                <TabItem Header="Diagnostics">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="System &amp; Runtime Diagnostics" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Application Version:" Foreground="#94A3B8"/>
                                        <TextBlock Text="FLOW v1.0.0 (Windows Native x64)" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Target Architecture:" Foreground="#94A3B8"/>
                                        <TextBlock Text="win-x64 (Self-Contained .NET 9.0)" Foreground="#CBD5E1"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Database Storage:" Foreground="#94A3B8"/>
                                        <TextBlock Text="SQLite v3 + WAL Mode + FTS5 Full-Text Search" Foreground="#CBD5E1"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Single-Instance Mutex:" Foreground="#94A3B8"/>
                                        <TextBlock Text="Active (FLOW_VoiceProductivity_SingleInstance_Mutex_v1)" Foreground="#10B981"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Inviolable Zero-Enter:" Foreground="#94A3B8"/>
                                        <TextBlock Text="Enforced (Zero VK_RETURN simulation)" Foreground="#10B981"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Privacy Sovereignty:" Foreground="#94A3B8"/>
                                        <TextBlock Text="100% Offline Local Processing — Zero Cloud Transmission" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Exit FLOW" Style="{StaticResource SecondaryButtonStyle}" Click="BtnExitApp_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 3. Footer Bar -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="FLOW is running locally on this PC. Dictation works system-wide in any text field." Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Local First • Offline Sovereignty • Content Lock" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
