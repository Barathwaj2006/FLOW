<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors (Windows 11 Fluent Soft Slate) -->
    <SolidColorBrush x:Key="BrushWindowBackground" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BrushSurfaceCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSurfaceElevated" Color="#E2E8F0"/>
