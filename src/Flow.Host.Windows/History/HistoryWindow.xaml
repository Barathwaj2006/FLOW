<Window x:Class="Flow.Host.Windows.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flow.Host.Windows.History"
        mc:Ignorable="d"
        Title="FLOW — History &amp; Productivity"
        Height="720" Width="1040"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F4F5F7"
        Foreground="#172B4D">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- KPI Tile Style -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0052CC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EBECF0"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area with Tabs -->
            <RowDefinition Height="*"/>
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DFE1E6" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FLOW" FontSize="20" FontWeight="Bold" Foreground="#0052CC" VerticalAlignment="Center"/>
                    <TextBlock Text="|" FontSize="18" Foreground="#C1C7D0" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="History &amp; Productivity" FontSize="16" FontWeight="SemiBold" Foreground="#42526E" VerticalAlignment="Center"/>
                    <Border Background="#E3FCEF" CornerRadius="3" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Offline Sovereignty" FontSize="11" FontWeight="SemiBold" Foreground="#006644"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Local DirectML / SQLite v3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#7A869A"/>
            </Grid>
        </Border>

        <!-- 2. Main Tabbed Navigation -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,8,16,8" Name="MainTabControl">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Dictation History -->
            <TabItem Header="Dictation History" Name="HistoryTab">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- Filter / Search Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Notification / Undo Banner -->
                        <RowDefinition Height="Auto"/>
                        <!-- History List / Empty State -->
                        <RowDefinition Height="*"/>
                        <!-- Pagination Controls -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Toolbar -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Search Box -->
                                <ColumnDefinition Width="*"/>
                                <!-- App Filter -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Lang Filter -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Favorites Check -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Refresh Button -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Input -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <TextBox Name="SearchTextBox"
                                         Height="32"
                                         VerticalContentAlignment="Center"
                                         Padding="8,0,24,0"
                                         FontSize="13"
                                         BorderBrush="#C1C7D0"
                                         KeyDown="SearchTextBox_KeyDown"/>
                                <TextBlock Name="SearchPlaceholder"
                                           Text="Search history (FTS5 indexed)..."
                                           IsHitTestVisible="False"
                                           Foreground="#8993A4"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           FontSize="13"/>
                                <Button Name="ClearSearchButton"
                                        Content="✕"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Width="20" Height="20"
                                        Margin="0,0,4,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#7A869A"
                                        Cursor="Hand"
                                        Click="ClearSearchButton_Click"/>
                            </Grid>

                            <!-- Application Filter ComboBox -->
                            <ComboBox Name="AppFilterComboBox"
                                      Grid.Column="1"
                                      Height="32"
                                      Width="160"
                                      Margin="0,0,10,0"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="AppFilterComboBox_SelectionChanged"/>

                            <!-- Language Filter ComboBox -->
                            <ComboBox Name="LangFilterComboBox"
                                      Grid.Column="2"
                                      Height="32"
                                      Width="140"
                                      Margin="0,0,10,0"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="LangFilterComboBox_SelectionChanged"/>

                            <!-- Favorites Filter -->
                            <CheckBox Name="FavoritesOnlyCheckBox"
                                      Grid.Column="3"
                                      Content="★ Favorites"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      FontWeight="SemiBold"
                                      Foreground="#42526E"
                                      Checked="FavoritesOnlyCheckBox_Changed"
                                      Unchecked="FavoritesOnlyCheckBox_Changed"/>

                            <!-- Refresh Button -->
                            <Button Grid.Column="4"
                                    Name="RefreshHistoryButton"
                                    Content="🔄 Refresh"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32"
                                    Click="RefreshHistoryButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Notification & Undo Banner -->
                    <Border Grid.Row="1"
                            Name="UndoBanner"
                            Background="#DEEBFF"
                            BorderBrush="#B3D4FF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,8"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Name="UndoBannerText" Text="Dictation entry deleted." Foreground="#0747A6" FontWeight="Medium" VerticalAlignment="Center"/>
                                <Button Name="UndoButton" Content="Undo" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" Padding="10,3" Click="UndoButton_Click"/>
                            </StackPanel>
                            <Button Name="DismissBannerButton" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#0747A6" Cursor="Hand" Click="DismissBannerButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Main History List Area -->
                    <Grid Grid.Row="2">
                        <!-- Scrollable Entry List -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl Name="HistoryItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="14,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <!-- Metadata Header -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Transcript Body -->
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Metadata & Actions Header -->
                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Badges & Timestamp -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Timestamp -->
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Foreground="#5E6C84"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Target App Badge -->
                                                        <Border Background="#F4F5F7" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Application}" FontSize="11" FontWeight="SemiBold" Foreground="#172B4D"/>
                                                        </Border>

                                                        <!-- Language Badge -->
                                                        <Border Background="#EAE6FF" BorderBrush="#C0B6F2" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding Language}" FontSize="11" FontWeight="SemiBold" Foreground="#403294"/>
                                                        </Border>

                                                        <!-- Duration & Words -->
                                                        <TextBlock Margin="10,0,0,0" FontSize="11" Foreground="#7A869A" VerticalAlignment="Center">
                                                            <Run Text="{Binding WordCount, Mode=OneWay}"/>
                                                            <Run Text="words ·"/>
                                                            <Run Text="{Binding Wpm, StringFormat='{}{0:F0} WPM', Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Right: Actions (Star, Copy, Delete) -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Favorite Button -->
                                                        <Button Tag="{Binding}"
                                                                Click="FavoriteButton_Click"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                FontSize="15"
                                                                Cursor="Hand"
                                                                ToolTip="Toggle Favorite"
                                                                Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding IsFavorite, Converter={x:Null}}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="☆"/>
                                                                        <Setter Property="Foreground" Value="#7A869A"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                <Setter Property="Text" Value="★"/>
                                                                                <Setter Property="Foreground" Value="#FFAB00"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>

                                                        <!-- Copy Button -->
                                                        <Button Tag="{Binding}"
                                                                Click="CopyButton_Click"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="📋 Copy"
                                                                FontSize="11"
                                                                Padding="8,3"
                                                                Margin="0,0,6,0"
                                                                ToolTip="Copy transcript text to clipboard"/>

                                                        <!-- Delete Button -->
                                                        <Button Tag="{Binding}"
                                                                Click="DeleteButton_Click"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="#BF2600"
                                                                Content="🗑"
                                                                FontSize="13"
                                                                Cursor="Hand"
                                                                Padding="4,2"
                                                                ToolTip="Delete transcript"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Transcript Body -->
                                                <TextBox Grid.Row="1"
                                                         Text="{Binding Text, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         TextWrapping="Wrap"
                                                         FontSize="13.5"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="#091E42"
                                                         Cursor="IBeam"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State Display -->
                        <Border Name="EmptyStateBorder"
                                Style="{StaticResource CardBorderStyle}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Padding="40,30"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🎙" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Name="EmptyStateTitle" Text="No dictation history found" FontSize="16" FontWeight="Bold" Foreground="#172B4D" HorizontalAlignment="Center"/>
                                <TextBlock Name="EmptyStateSubtitle" Text="Dictate using [Right Alt] to see your transcripts here." FontSize="13" Foreground="#6B778C" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pagination Footer -->
                    <Border Grid.Row="3" Background="#FFFFFF" Style="{StaticResource CardBorderStyle}" Padding="12,8" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Name="PageSummaryText" Text="Page 1 of 1 (0 entries)" VerticalAlignment="Center" FontSize="12" Foreground="#5E6C84"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Name="PrevPageButton" Content="◀ Previous" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="PrevPageButton_Click"/>
                                <Button Name="NextPageButton" Content="Next ▶" Style="{StaticResource SecondaryButtonStyle}" Click="NextPageButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Productivity & Insights -->
            <TabItem Header="Productivity &amp; Insights" Name="StatsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Time Range Selector -->
                            <RowDefinition Height="Auto"/>
                            <!-- 6 KPI Cards Grid -->
                            <RowDefinition Height="Auto"/>
                            <!-- Top Apps & Top Languages -->
                            <RowDefinition Height="Auto"/>
                            <!-- Deterministic Insights Card -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Time Window Selector -->
                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Time Range:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#172B4D"/>
                                    <RadioButton Name="RangeTodayRadio" Content="Today" GroupName="StatsRange" VerticalAlignment="Center" Margin="0,0,14,0" Checked="TimeRangeRadio_Checked"/>
                                    <RadioButton Name="Range7DaysRadio" Content="7 Days" GroupName="StatsRange" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="TimeRangeRadio_Checked"/>
                                    <RadioButton Name="Range30DaysRadio" Content="30 Days" GroupName="StatsRange" VerticalAlignment="Center" Margin="0,0,14,0" Checked="TimeRangeRadio_Checked"/>
                                    <RadioButton Name="RangeAllTimeRadio" Content="All Time" GroupName="StatsRange" VerticalAlignment="Center" Checked="TimeRangeRadio_Checked"/>
                                </StackPanel>
                                <Button Content="🔄 Refresh Statistics" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Click="RefreshStatsButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- KPI Grid (3x2) -->
                        <Grid Grid.Row="1" Margin="-6,0,-6,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Card 1: Total Words -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="TOTAL WORDS DICTATED" FontSize="11" FontWeight="Bold" Foreground="#6B778C"/>
                                    <TextBlock Name="KpiTotalWords" Text="0" FontSize="26" FontWeight="Bold" Foreground="#0052CC" Margin="0,4,0,0"/>
                                    <TextBlock Text="Accurate local whisper ASR" FontSize="11" Foreground="#7A869A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Total Sessions -->
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="TOTAL SESSIONS" FontSize="11" FontWeight="Bold" Foreground="#6B778C"/>
                                    <TextBlock Name="KpiTotalSessions" Text="0" FontSize="26" FontWeight="Bold" Foreground="#00875A" Margin="0,4,0,0"/>
                                    <TextBlock Text="Completed dictation turns" FontSize="11" Foreground="#7A869A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Average WPM -->
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="AVERAGE SPEAKING SPEED" FontSize="11" FontWeight="Bold" Foreground="#6B778C"/>
                                    <TextBlock Name="KpiAverageWpm" Text="0.0 WPM" FontSize="26" FontWeight="Bold" Foreground="#FF8B00" Margin="0,4,0,0"/>
                                    <TextBlock Text="Words per minute in active turns" FontSize="11" Foreground="#7A869A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Active Duration -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE DICTATION TIME" FontSize="11" FontWeight="Bold" Foreground="#6B778C"/>
                                    <TextBlock Name="KpiActiveDuration" Text="0m 0s" FontSize="26" FontWeight="Bold" Foreground="#6554C0" Margin="0,4,0,0"/>
                                    <TextBlock Text="Microphone recording time" FontSize="11" Foreground="#7A869A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Estimated Time Saved -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="ESTIMATED TIME SAVED" FontSize="11" FontWeight="Bold" Foreground="#6B778C"/>
                                    <TextBlock Name="KpiTimeSaved" Text="0m saved" FontSize="26" FontWeight="Bold" Foreground="#00A3BF" Margin="0,4,0,0"/>
                                    <TextBlock Text="Calculated vs 40 WPM baseline typing" FontSize="11" Foreground="#7A869A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 6: Daily Streak -->
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE STREAK" FontSize="11" FontWeight="Bold" Foreground="#6B778C"/>
                                    <TextBlock Name="KpiStreak" Text="0 days" FontSize="26" FontWeight="Bold" Foreground="#DE350B" Margin="0,4,0,0"/>
                                    <TextBlock Name="KpiLongestStreak" Text="Longest streak: 0 days" FontSize="11" Foreground="#7A869A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Top Apps & Top Languages (2 Columns) -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Top Apps Card -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="Top Applications" FontSize="14" FontWeight="Bold" Foreground="#172B4D" Margin="0,0,0,10"/>
                                    <ItemsControl Name="TopAppsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <TextBlock Text="{Binding Key}" FontWeight="Medium" FontSize="12.5" Foreground="#344563"/>
                                                    <TextBlock Text="{Binding Value, StringFormat='{}{0} dictations'}" HorizontalAlignment="Right" FontSize="12" Foreground="#7A869A"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Top Languages Card -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="Top Languages" FontSize="14" FontWeight="Bold" Foreground="#172B4D" Margin="0,0,0,10"/>
                                    <ItemsControl Name="TopLangsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <TextBlock Text="{Binding Key}" FontWeight="Medium" FontSize="12.5" Foreground="#344563"/>
                                                    <TextBlock Text="{Binding Value, StringFormat='{}{0} dictations'}" HorizontalAlignment="Right" FontSize="12" Foreground="#7A869A"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Insights Summary Card -->
                        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="💡" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Deterministic Productivity Insights" FontSize="14" FontWeight="Bold" Foreground="#172B4D"/>
                                </StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Margin="0,3" FontSize="12.5" Foreground="#344563">
                                            <Run Text="Most Active Day: " FontWeight="SemiBold"/>
                                            <Run Name="InsightMostActiveDay" Text="None"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,3" FontSize="12.5" Foreground="#344563">
                                            <Run Text="Primary Application: " FontWeight="SemiBold"/>
                                            <Run Name="InsightPrimaryApp" Text="None"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Margin="0,3" FontSize="12.5" Foreground="#344563">
                                            <Run Text="Primary Language: " FontWeight="SemiBold"/>
                                            <Run Name="InsightPrimaryLang" Text="None"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,3" FontSize="12.5" Foreground="#344563">
                                            <Run Text="Longest Session: " FontWeight="SemiBold"/>
                                            <Run Name="InsightLongestSession" Text="0s"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Export -->
            <TabItem Header="Export" Name="ExportTab">
                <Grid Margin="0,10,0,0">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="24,20" VerticalAlignment="Top">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                            <TextBlock Text="Export Dictation History" FontSize="18" FontWeight="Bold" Foreground="#172B4D" Margin="0,0,0,6"/>
                            <TextBlock Text="Export your dictation transcripts to a local file for backups or analysis. Your transcripts remain strictly local and private on your device."
                                       FontSize="13" TextWrapping="Wrap" Foreground="#5E6C84" Margin="0,0,0,20"/>

                            <!-- Export Format Selection -->
                            <TextBlock Text="Choose Format:" FontWeight="SemiBold" FontSize="13" Foreground="#172B4D" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,16">
                                <RadioButton Name="FormatJsonRadio" Content="JSON (.json) — Complete structured schema with session metadata" IsChecked="True" Margin="0,3"/>
                                <RadioButton Name="FormatCsvRadio" Content="CSV (.csv) — Spreadsheet compatible tabular records" Margin="0,3"/>
                                <RadioButton Name="FormatTxtRadio" Content="Plain Text (.txt) — Clean, chronological text archive" Margin="0,3"/>
                            </StackPanel>

                            <!-- Export Scope Selection -->
                            <TextBlock Text="Scope:" FontWeight="SemiBold" FontSize="13" Foreground="#172B4D" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,20">
                                <RadioButton Name="ScopeAllRadio" Content="Export All History Records" IsChecked="True" Margin="0,3"/>
                                <RadioButton Name="ScopeFilteredRadio" Content="Export Current Search &amp; Filtered Results" Margin="0,3"/>
                            </StackPanel>

                            <!-- Export Action Button -->
                            <Button Name="ExportExecuteButton"
                                    Content="💾 Choose File Location &amp; Export..."
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="18,8"
                                    FontSize="13"
                                    Click="ExportExecuteButton_Click"/>

                            <!-- Export Result Banner -->
                            <Border Name="ExportResultBanner"
                                    Background="#E3FCEF"
                                    BorderBrush="#ABF5D1"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="14,10"
                                    Margin="0,18,0,0"
                                    Visibility="Collapsed">
                                <TextBlock Name="ExportResultText" Text="Export completed successfully." FontSize="12.5" FontWeight="SemiBold" Foreground="#006644" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DFE1E6" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <TextBlock Name="GlobalStatusBarText" Text="Ready · Zero Cloud Audio · Zero Unintentional Execute" FontSize="11.5" Foreground="#7A869A" VerticalAlignment="Center"/>
                <TextBlock Text="FLOW v1.0 (Windows Native)" HorizontalAlignment="Right" FontSize="11" Foreground="#A5B2C6" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
