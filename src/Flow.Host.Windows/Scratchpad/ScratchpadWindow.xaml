<Window x:Class="Flow.Host.Windows.Scratchpad.ScratchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flow.Host.Windows.Scratchpad"
        mc:Ignorable="d"
        Title="FLOW — Scratchpad &amp; Quick Capture"
        Height="750" Width="1100"
        MinHeight="580" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F4F5F7"
        Foreground="#172B4D">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Card Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0052CC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EBECF0"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFEBE6"/>
            <Setter Property="Foreground" Value="#DE350B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Undo Toast Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DFE1E6" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FLOW" FontSize="20" FontWeight="Bold" Foreground="#0052CC" VerticalAlignment="Center"/>
                    <TextBlock Text="|" FontSize="18" Foreground="#C1C7D0" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Scratchpad &amp; Quick Capture" FontSize="16" FontWeight="SemiBold" Foreground="#42526E" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#6B778C" FontSize="13" Margin="0,0,16,0"/>
                    <Button Content="+ New Scratchpad" Style="{StaticResource PrimaryButtonStyle}" Click="OnNewScratchpadClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Split: Sidebar (Left) + Editor (Right) -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="500"/>
                <!-- Splitter -->
                <ColumnDefinition Width="8"/>
                <!-- Editor -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Search + Filter Tabs + Scratchpads List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Search Box -->
                        <RowDefinition Height="Auto"/>
                        <!-- Filter Chips (All, Pinned, Recent) -->
                        <RowDefinition Height="Auto"/>
                        <!-- List -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Row="0" Background="#FAFBFC" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#6B778C"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                     FontSize="13"/>
                            <Button Grid.Column="2" Content="✕" Click="OnClearSearchClick" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Foreground="#8993A4" Padding="4,0"
                                    Visibility="{Binding SearchText.Length, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                        </Grid>
                    </Border>

                    <!-- Filter Chips -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="All" IsChecked="True" GroupName="ScratchpadFilters" Click="OnFilterAllClick" Margin="0,0,8,0"/>
                        <RadioButton Content="Pinned" GroupName="ScratchpadFilters" Click="OnFilterPinnedClick" Margin="0,0,8,0"/>
                        <RadioButton Content="Recent" GroupName="ScratchpadFilters" Click="OnFilterRecentClick"/>
                    </StackPanel>

                    <!-- ListBox -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,10"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F4F5F7"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#DEEBFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Title & Pin Icon -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="#172B4D" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PinIndicator}" FontSize="12" Margin="4,0,0,0"/>

                                    <!-- Content Preview -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ContentPreview}"
                                               FontSize="12" Foreground="#6B778C" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

                                    <!-- Date & Word Count -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="#8993A4"/>
                                        <TextBlock Text=" • " FontSize="11" Foreground="#C1C7D0"/>
                                        <TextBlock Text="{Binding WordCount, StringFormat='{}{0} words'}" FontSize="11" Foreground="#8993A4"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent" Cursor="SizeWE"/>

            <!-- Editor Pane (Right) -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Title & Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Metadata Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Content Editor -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Title & Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title Input -->
                        <TextBox Grid.Column="0" Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" FontWeight="SemiBold" Foreground="#172B4D"
                                 BorderThickness="0,0,0,1" BorderBrush="#DFE1E6" Padding="4,6"
                                 Background="Transparent" VerticalAlignment="Center"/>

                        <!-- Action Toolbar: Pin, Copy, Export, Delete -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="📌 Pin" Style="{StaticResource SecondaryButtonStyle}" Click="OnPinClick" Margin="0,0,8,0"/>
                            <Button Content="📋 Copy" Style="{StaticResource SecondaryButtonStyle}" Click="OnCopyClick" Margin="0,0,8,0"/>
                            <Button Content="📤 Export" Style="{StaticResource SecondaryButtonStyle}" Click="OnExportClick" Margin="0,0,8,0"/>
                            <Button Content="🗑️ Delete" Style="{StaticResource DangerButtonStyle}" Click="OnDeleteClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Word Count & Autosave Status -->
                    <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#EBECF0" BorderThickness="0,1,0,1" Padding="8,4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WordCount, StringFormat='Words: {0}'}" FontSize="12" Foreground="#6B778C" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding CharacterCount, StringFormat='Characters: {0}'}" FontSize="12" Foreground="#6B778C"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12" Foreground="#0052CC" FontWeight="Medium"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: Main Text Editor -->
                    <TextBox x:Name="EditorTextBox" Grid.Row="2"
                             Text="{Binding EditorContent, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             FontSize="15" FontFamily="Segoe UI" Foreground="#172B4D"
                             BorderThickness="0" Background="Transparent"
                             Padding="4" VerticalAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Undo Toast Banner (Reversible Deletion) -->
        <Border Grid.Row="2" Background="#DEEBFF" BorderBrush="#B3D4FF" BorderThickness="1" CornerRadius="4"
                Padding="16,8" Margin="16,0,16,8" Visibility="{Binding IsUndoVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ℹ️ " VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastDeletedTitle, StringFormat='Scratchpad \'{0}\' moved to trash.'}"
                               FontWeight="Medium" Foreground="#0747A6" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Undo" Style="{StaticResource PrimaryButtonStyle}" Click="OnUndoClick" Padding="12,4"/>
            </Grid>
        </Border>

        <!-- 4. Footer Status Bar -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#DFE1E6" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="FLOW Local Scratchpad — 100% Offline SQLite • Direct dictation into active editor with Zero-Enter"
                           FontSize="11" Foreground="#8993A4" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Phase 9 Production Build" FontSize="11" Foreground="#8993A4" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
