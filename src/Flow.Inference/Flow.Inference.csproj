    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Flow.Inference</RootNamespace>
    <AssemblyName>Flow.Inference</AssemblyName>
    <Description>FLOW Native Inference Engine: DirectML ONNX Runtime and whisper.cpp AVX2 Interop</Description>
